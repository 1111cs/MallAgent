{
  "suite": "huawei-mall-d1-missing-closed-loop",
  "version": "d1-v2",
  "principalId": "U001",
  "rules": {
    "sameConversationWithinCase": true,
    "freshConversationPerCase": true,
    "injectExpectedPendingTaskIdFromPriorStep": true,
    "assertPendingAbsentAfterTerminalStep": true
  },
  "cases": [
    {
      "caseId": "MISS-01",
      "principalId": "U001",
      "steps": [
        {
          "stepId": "MISS-01-A",
          "question": "帮我查维修进度。",
          "expected": {
            "expectedResolutionStatus": "MISSING",
            "expectedTools": [],
            "expectedToolSequence": [],
            "expectedTaskStatus": "NEED_CLARIFICATION",
            "expectedClarificationAction": "CREATED",
            "expectedPendingTaskIdPresent": true,
            "failureStage": "MISSING_PARAMETER_HANDLING",
            "expectedIntent": [
              "REPAIR_PROGRESS"
            ],
            "expectedResource": [
              "MCP:getRepairProgress"
            ],
            "expectedMissingParameters": {
              "getRepairProgress": [
                "serviceNo",
                "phone"
              ]
            },
            "forbiddenTools": [
              "getRepairProgress"
            ]
          }
        },
        {
          "stepId": "MISS-01-B",
          "question": "维修单号是 WX202609001。",
          "expectedPendingTaskIdFrom": "MISS-01-A",
          "expected": {
            "expectedIntent": [
              "REPAIR_PROGRESS"
            ],
            "expectedResource": [
              "MCP:getRepairProgress"
            ],
            "expectedResolutionStatus": "RESOLVED",
            "expectedTools": [
              "getRepairProgress"
            ],
            "expectedToolSequence": [
              "getRepairProgress"
            ],
            "expectedParameterSource": {
              "getRepairProgress": {
                "serviceNo": "CLARIFICATION_INPUT",
                "principalId": "AUTH_CONTEXT"
              }
            },
            "expectedTransportStatus": {
              "getRepairProgress": "SUCCESS"
            },
            "expectedBusinessStatus": {
              "getRepairProgress": "OK"
            },
            "expectedTaskStatus": "COMPLETED",
            "expectedClarificationAction": "RESUMED_AND_CLEARED",
            "expectedPendingTaskIdPresent": true,
            "failureStage": "MISSING_PARAMETER_RESUME"
          }
        }
      ]
    },
    {
