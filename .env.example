# Bootstrap database
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5432/ragent?client_encoding=UTF8
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=change-me

# Redis and infrastructure
SPRING_DATA_REDIS_HOST=127.0.0.1
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=change-me
ROCKETMQ_NAME_SERVER=127.0.0.1:9876
RUSTFS_URL=http://127.0.0.1:9000
RUSTFS_ACCESS_KEY_ID=change-me
RUSTFS_SECRET_ACCESS_KEY=change-me

# Model providers. Configure only providers that you use.
BAILIAN_API_KEY=
SILICONFLOW_API_KEY=
AIHUBMIX_API_KEY=

# MallAgent MCP and trusted fixture identity.
MALL_AGENT_MCP_URL=http://127.0.0.1:9099
HUAWEI_MALL_JDBC_URL=jdbc:postgresql://127.0.0.1:5432/ragent?currentSchema=huawei_mall_mock
HUAWEI_MALL_DB_USER=postgres
HUAWEI_MALL_DB_PASSWORD=change-me
HUAWEI_MALL_AUTH_MAP=<authenticated-user-id>=U001
HUAWEI_MALL_RUNTIME_SECRET=replace-with-at-least-32-random-characters

